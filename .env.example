# Copy to .env for local use. Never commit real keys.
SECRET_KEY=change-me
# AI is optional. Leave LLM_API_KEY empty to run in offline mode (exact checks + word lists).
LLM_PROVIDER=gemini            # gemini, or openai for any OpenAI-compatible API such as Groq
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1   # only for LLM_PROVIDER=openai
# DB_PATH=instance/proofmark.db
